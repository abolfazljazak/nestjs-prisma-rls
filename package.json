{
  "name": "nestjs-prisma-rls",
  "version": "0.1.1",
  "description": "Multi-tenant isolation for NestJS + Prisma, enforced by Postgres Row-Level Security",
  "license": "MIT",
  "author": "Abolfazl Jazak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abolfazljazak/nestjs-prisma-rls.git"
  },
  "homepage": "https://github.com/abolfazljazak/nestjs-prisma-rls#readme",
  "bugs": {
    "url": "https://github.com/abolfazljazak/nestjs-prisma-rls/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "prepublishOnly": "npm run build",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "pretest": "prisma generate",
    "db:reset": "prisma migrate reset --force",
    "bench": "tsx bench/bench.ts",
    "test:pack": "npm run build && tsx scripts/pack-smoke.ts"
  },
  "keywords": [
    "nestjs",
    "prisma",
    "postgres",
    "postgresql",
    "rls",
    "row-level-security",
    "multi-tenant",
    "multitenancy"
  ],
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "@prisma/client": "^7.10.0",
    "rxjs": "^7"
  },
  "devDependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/testing": "^12.1.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "pg": "^8.23.1",
    "prisma": "^7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
